#!/usr/bin/env bash
# 提交前闸门 · 两件事,都带出路
#
#   ① 敏感文件:密钥 / 账号数据 / 原图缓存,一律拦住(R-04 / R-59)
#   ② 决策层文档 docs/decisions/ 下的全部四份:允许改,但必须显式声明,且在提交历史里留痕
#
# 出路是刻意留的 —— R-67 记过:没有出路的守卫,会被撞上它的人在半夜关掉。
# 但用掉出路这件事本身必须留痕,所以 ② 的覆盖会在 commit-msg 里写成一条 trailer。
set -uo pipefail

# 🔴 必须关掉 core.quotepath:开着的话中文路径会变成 "docs/\346\226\207..." 这种八进制转义,
# 而本仓库的文档【全是中文名】—— 决策层那道闸会静默失效,看起来一直在放行。
#
# 🔴 同一种静默失效的第二种成因:文档【搬了目录或改了名】而这里的正则没跟着改。
# 这条正则已经被同一种成因掐断过两次:2026-08-31 分目录(docs/01-04 → docs/decisions/),
# 同日去编号(docs/decisions/01-04 → 文件名不再带号,其中一份还成了 INDEX.md)。
# 现在匹配【整个目录】而不是文件名前缀 —— decisions/ 下的每一份都是决策层,不靠名字识别。
# 改目录或改名必查此处:grep -rn 'docs/' .githooks scripts。
staged() { git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR; }
list_() { while IFS= read -r f; do [ -n "$f" ] && printf '    %s\n' "$f" >&2; done; }
red()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
dim()  { printf '\033[2m%s\033[0m\n'  "$*" >&2; }

# ── ① 敏感文件 ──
# 🔴 正则不在这里,在 scripts/sensitive-paths.txt —— CI 那道闸读的是同一个文件(B0 §8.2)。
# 抄两遍那一版三个月后一定分叉。过滤 # 与空行是必须的:grep -f 不认注释,空模式匹配一切。
SENSITIVE="$(git rev-parse --show-toplevel)/scripts/sensitive-paths.txt"
hits="$(staged | grep -E -f <(grep -vE '^#|^$' "$SENSITIVE") || true)"
if [[ -n "$hits" ]]; then
  red "✗ 拒绝提交 —— 暂存区里有密钥/运行时数据/原图缓存:"
  printf '%s\n' "$hits" | list_
  dim ""
  dim "  auth-keys.properties 属于【数据】不属于配置(docs/后端详设 §6.9 / R-59)。"
  dim "  原图只允许本机短期缓存,仓库是「共享」的一种(R-04)。"
  dim ""
  dim "  确认是误判时:  ALLOW_SENSITIVE=1 git commit ..."
  [[ "${ALLOW_SENSITIVE:-}" == "1" ]] || exit 1
  red "  ⚠ ALLOW_SENSITIVE=1 已放行 —— 请自己确认这不是密钥"
fi

# ── ② 决策层文档 ──
DEC="$(staged | grep -E '^docs/decisions/' || true)"
rm -f "$(git rev-parse --git-dir)/DECISION_EDIT" 2>/dev/null
if [[ -n "$DEC" ]]; then
  if [[ "${ALLOW_DECISION_EDIT:-}" != "1" ]]; then
    red "✗ 拒绝提交 —— 改动了决策层文档:"
      printf '%s\n' "$DEC" | list_
    dim ""
    dim "  执行清单 原文:「实施路径 的关卡判据在这里一个字都不改」。"
    dim "  新调研与原决策冲突时,在下游记录更正 + 在上游【加注指针】,不静默改写原文。"
    dim ""
    dim "  确实是加注/勘误时:  ALLOW_DECISION_EDIT=1 git commit ..."
    dim "  (会在提交信息里自动留下一条 Decision-layer-edit trailer)"
    exit 1
  fi
  printf '%s\n' "$DEC" > "$(git rev-parse --git-dir)/DECISION_EDIT"
  red "  ⚠ ALLOW_DECISION_EDIT=1 已放行,将在提交信息里留痕"
fi

exit 0
