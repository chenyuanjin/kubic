// 壳的构建与打包配置。
//
// 🔴 为什么是 .json5 而不是 .json:
//   这份配置里有【三处刻意留空】,而留空和忘了填在 JSON 里长得一模一样。
//   下一个人看到 beforeBuildCommand 是空串,最自然的动作是顺手填上 `npm run build` ——
//   那正是这份方案要挡的事。JSON 放不下理由,理由就只能去 README 里,
//   而没有人在改一行配置之前会去读 README。
//   (Tauri 2 原生支持 json5,靠 tauri / tauri-build 的 config-json5 feature。)
{
  $schema: 'https://schema.tauri.app/config/2',
  productName: '考点盲区',
  version: '0.1.0',

  // 🔴 `local.kaodian.*` 不是一次域名声明。
  // 域名(L-A1)还没注册,而签名主体将来要与域名实名一致(docs/18 §4.4),
  // 所以这个串一定会改。改它【不影响用户数据】—— 数据路径刻意没有挂在 identifier 上,
  // 理由写在 src/platform/macos.rs。
  identifier: 'local.kaodian.desktop',

  build: {
    // 🔴 显式留空,不是忘了填。
    // 填上 `npm run build` 会出现【第二条构建路径,而它绕过 build.sh 步骤 ① 的隔离校验】——
    // 绕过隔离校验的构建路径和没有隔离校验是一回事(docs/18 §2.3)。
    // 前端构建是 build.sh 步骤 ② 的事,它会真的 cd 进 web/ 去读那边的 .npmrc
    //(npm 读的是当前工作目录的 .npmrc,所以不能用 npm --prefix)。
    beforeBuildCommand: '',
    beforeDevCommand: '',

    // 🔴 frontendDist 刻意不配。
    // 壳不走 tauri:// 资源协议:它用 include_dir! 在编译期把 web/dist 内嵌进二进制,
    // 再由自己的回环服务直出(docs/18 §3.3)。配上 frontendDist 会让同一批字节在
    // 二进制里存两份,并多出一个永远不会被访问、却真实存在的第二个 origin。
  },

  app: {
    // 🔴 空数组不是漏配。
    // 窗口在 src/main.rs 的 setup() 里建,因为它必须发生在【端口绑定成功之后】——
    // 端口被占时先弹出一个空白窗口再报错,就不是响亮的失败了(R-109)。
    windows: [],

    security: {
      // 留空 = 用页面自己的策略。壳不往页面里注入任何东西,也不需要放宽任何东西。
      csp: null,
      // 空 = 采用 capabilities/ 目录下的全部文件。那两个文件各自不授予任何权限,
      // 理由写在文件里。
      capabilities: [],
    },

    // 🔴 false。打开它等于往页面里注入 window.__TAURI__,
    // 那正是「壳内 IPC 契约」这条【不做】的入口(docs/18 §九)。
    // 壳与前端之间只有一个接口:一个 HTTP origin。
    withGlobalTauri: false,
  },

  bundle: {
    active: true,

    // 本轮只出 macOS。iOS / Android 走 `cargo tauri ios|android build`,
    // 不由这里决定(KUBI-66 / KUBI-67)。
    //
    // 🔴 只出 .app,【不出 .dmg】,这是一次判断不是一次将就:
    //   · .app 就是可安装的应用 —— 拖进「应用程序」即可,双击能开。
    //   · .dmg 是【分发】的包装,而本轮没有分发(docs/18 §4.4:出现第二个使用者那天才需要
    //     Developer ID + 公证)。给一个自用的东西做分发包装,是在为还没发生的事付成本。
    //   · 而且 tauri 的 dmg 步骤要跑一段 AppleScript 去摆 Finder 窗口,那要求把
    //     【Finder 自动化权限】授予跑构建的那个终端。为了一个本轮用不上的产物,
    //     去要一个与产品无关的系统权限 —— 这个交换不划算。
    //     (在没有这个权限的环境里它会以 AppleEvent 超时 -1712 失败,而那是环境的事,
    //      不是壳的事;把它留在 targets 里等于让构建在一件不重要的事上红。)
    //
    // 何时改变:与「什么时候才要花钱签名」同一个触发条件 —— 有第二个使用者。
    targets: ['app'],

    // 由 web/public/favicon.svg 生成(见 build.sh)。
    // 用产品自己的图标,不新画一个 —— 壳不出新视觉方向。
    icon: ['icons/32x32.png', 'icons/128x128.png', 'icons/128x128@2x.png', 'icons/icon.icns'],

    macOS: {
      minimumSystemVersion: '10.15',
    },

    // 不做自动更新:要一个签名密钥 + 一个托管的 manifest 端点,
    // 两样都是新增的年费与新增的实名。何时改变:有第二个使用者(docs/18 §2.5)。
    createUpdaterArtifacts: false,
  },
}
