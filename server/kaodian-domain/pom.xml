<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.kaodian</groupId>
		<artifactId>kaodian-server</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>kaodian-domain</artifactId>
	<name>kaodian-domain</name>
	<description>骨架层 / 行为层 / 盲区 —— 产品公式本身</description>

	<!--
		这个模块【没有 web 依赖】,而且不该有。
		量过一次:collect/coverage/recognize/syllabus 四个包用到的 spring 类型只有
		@Component / @Service / @Value / @Autowired,外加 jakarta.validation 与 Jackson。
		一个 HttpServletRequest 都没有 —— 「盲区 = 骨架层 − 行为层」这条公式跟 HTTP 无关。
		哪天有人想在这里 import 一个 Controller,Maven 会先一步告诉他放错地方了。
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				依赖图闸门。B0-平台底座与横切契约 §10.2:不写脚本 —— grep 只看直接依赖,
				有人引一个自己带 kaodian-auth 的库,pom 里一个字样都没有而那条边已经建出来了。
				enforcer 看的是解析后的依赖树,且随 validate 阶段自动跑(§10.3 主防线)。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>无环依赖图</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>com.kaodian:kaodian-auth</exclude>
									</excludes>
									<!-- 一行不折行:Maven 原样输出,折行会把这里的缩进 tab 一起打到终端上。 -->
									<message>依赖图上唯一不许有的那条边。domain/agent 依赖 auth,领域层就再也不能脱离账号体系被测。见 B0-平台底座与横切契约 §十。</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				打一个 test-jar。唯一的理由是两个测试替身:
				{@code InMemoryAssertionStore} / {@code InMemoryRecordTagStore}。
				它们既被本模块的 TaggingServiceTest 用,也被 app 模块的 6 个接口测试用 ——
				那些接口测试拿它们是为了「一个切片测试不该往真实的 ~/.kaodian 里写文件」。

				替代方案是把两个替身复制一份到 app,那就有了两份会各自漂移的假存储,
				而它们模拟的正是记录数据 —— 这个产品的全部资产。宁可多一个 test-jar。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
