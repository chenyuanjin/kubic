# 🔴 值一律加单引号,不是为了好看。
# deploy/app.sh 用 `set -a; . ./.env` 把这个文件当 shell 脚本读,
# 而 JDBC 连接串里有 `&` —— 未加引号时 shell 把它当成「后台执行」,
# 于是 KAODIAN_DB_URL 变成空串,应用悄悄退回默认的 3306 端口,
# 表现是 `Connection refused`,而看 .env 一切正常。实测踩过一次。
# docker compose 读同一个文件时会把单引号剥掉,两边都对。

# 拷成 deploy/.env 再填。🔴 deploy/.env 在 .gitignore 里,口令永远不进仓库(R-08)。
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# 三个口令用 `openssl rand -base64 24` 现生成,不要用示例值。

# —— MySQL ——
MYSQL_ROOT_PASSWORD='CHANGE_ME_root'
MYSQL_PASSWORD='CHANGE_ME_app'
# 应用侧的连接串。端口是 3307:宿主机的 3306 留给别人,而且只发布到 127.0.0.1。
KAODIAN_DATA_STORE='jdbc'
KAODIAN_DB_URL='jdbc:mysql://127.0.0.1:3307/kaodian?sslMode=DISABLED&allowPublicKeyRetrieval=true&characterEncoding=utf8&serverTimezone=UTC&rewriteBatchedStatements=true'
KAODIAN_DB_USER='kaodian'
KAODIAN_DB_PASSWORD='CHANGE_ME_app'

# —— Redis ——
REDIS_PASSWORD='CHANGE_ME_redis'
KAODIAN_SMS_STORE='redis'
KAODIAN_REDIS_HOST='127.0.0.1'
KAODIAN_REDIS_PORT='6380'
KAODIAN_REDIS_PASSWORD='CHANGE_ME_redis'

# —— 反代的门 ——
# HASH 用 `docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的口令'` 生成。
# 🔴 单引号包起来,bcrypt 串里的 $ 保持【单个】不要写成 $$:
#    这个值是通过 caddy 服务的 env_file 原样传进容器的,不走 compose 的 ${...} 插值,
#    所以不需要转义;写成 $$ 反而会让哈希对不上,表现是「口令永远不对」。
KADDY_NOTE='见 Caddyfile:这道门挡的是「谁能连上这套测试环境」,不是端点级鉴权'
KAODIAN_TEST_USER='kaodian'
KAODIAN_TEST_PASS_HASH='CHANGE_ME_bcrypt_hash'
# 门票 cookie 的值。浏览器拿它过门,好让 Authorization 这个头空出来给应用的 Bearer 令牌
# ——两者共用一个头,浏览器里【不可能同时成立】,理由与实测在 Caddyfile 的 /__gate 那段。
# 与上面的口令是两份不同的秘密:口令用来【领票】,这个值就是【票】本身。
# 生成:`openssl rand -hex 16`
KAODIAN_TEST_GATE='CHANGE_ME_openssl_rand_hex_16'

# —— 后端进程 ——
# 反代在前面,所以这两行要一起开。理由见 Caddyfile 里 reverse_proxy 那段注释。
KAODIAN_TRUST_FORWARDED_FOR='true'
# 联调期允许的浏览器来源,逗号分隔。留空则采用 application.properties 里的默认值。
# 🔴 浏览器走 Caddy 时是【同源】的(静态与 /api 同一个 :8090,Caddy 不改 Host),
#    所以 iPad / iPhone / Android / Web 四个端都不需要出现在这一行里。
#    需要出现在这里的只有「页面 origin ≠ 后端 origin」的那些:vite dev,以及壳的 127.0.0.1:17840。
KAODIAN_CORS_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:17840'

# —— agent(可选)——
# 不填就是 StubAgentLlm,不发真请求、不花钱。
# KAODIAN_MODEL_KEY=
